# ---------------------------------------------------------------------------
# AI App Factory - example environment file.
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
API_HOST=0.0.0.0
# Comma separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
POSTGRES_USER=aiaf
POSTGRES_PASSWORD=aiaf
POSTGRES_DB=aiaf
DATABASE_URL=postgresql://aiaf:aiaf@localhost:5432/aiaf?schema=public

# --- Auth --------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=12h
# Optional: created on first boot when set, so you can log in immediately.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Queue -------------------------------------------------------------------
# Leave empty to use the in-process queue (no Redis required for local dev).
REDIS_URL=

# --- LLM provider ------------------------------------------------------------
# openai | mock   ("mock" needs no API key: deterministic, clearly-flagged output)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Model routing by task tier.
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_BALANCED=gpt-4o
LLM_MODEL_DEEP=gpt-4o
LLM_MAX_RETRIES=2

# --- Search / research provider ---------------------------------------------
# tavily | mock
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=8

# --- Code generation provider ------------------------------------------------
# export | mock  (V1 exports the prompt; autonomous Codex runs are out of scope)
CODEGEN_PROVIDER=export

# --- Cost control ------------------------------------------------------------
# Hard ceilings enforced by the orchestrator before every agent call.
DEFAULT_RUN_BUDGET_USD=5
DEFAULT_RUN_TOKEN_BUDGET=400000
MAX_AGENT_RETRIES=1

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
