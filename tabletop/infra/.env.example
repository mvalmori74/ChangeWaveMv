# Copia questo file in .env e compila. Il file .env NON va nel repository.

POSTGRES_DB=tavolo
POSTGRES_USER=tavolo
# Genera una password lunga e casuale. Niente password di default, mai.
POSTGRES_PASSWORD=

# Secondo disco per i backup (F11). Esempi:
#   Windows : D:/backup-tavolo
#   Linux   : /mnt/backup/tavolo
# Una copia sullo stesso disco del server NON e' un backup.
PERCORSO_BACKUP=

# Token del tunnel, dal pannello del servizio. Serve solo con il profilo "tunnel":
#   docker compose --profile tunnel up -d
TOKEN_TUNNEL=

VERSIONE=sviluppo
ORE_FRA_BACKUP=12
GIORNI_CONSERVAZIONE_BACKUP=30
